{
  "name": "ciaranlyons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "lint": "astro check",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs src/lib/*.test.mjs",
    "build": "node scripts/clean-dist.mjs && astro check && astro build && node scripts/verify-og-images.mjs && pagefind --site dist && node scripts/write-well-known.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:ui": "playwright test",
    "test:ui:update": "playwright test --update-snapshots",
    "notes:sync": "node scripts/sync-bsky-notes.mjs",
    "links:sync": "node scripts/sync-feedly-links.mjs",
    "links:audit": "node scripts/audit-link-destinations.mjs",
    "links:annotate": "node scripts/annotate-link-destinations.mjs",
    "links:recover-archive": "node scripts/recover-archived-links.mjs",
    "links:recover-feedproxy": "node scripts/recover-feedproxy-links.mjs",
    "links:recover-search": "node scripts/recover-web-search-links.mjs",
    "links:validate-artifact": "node scripts/validate-links-artifact.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "standard:publish": "node scripts/publish-standard-site.mjs",
    "secrets:publish": "tsx scripts/publish-1password-secrets.ts",
    "secrets:refresh": "tsx scripts/refresh-1password-secrets.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "3.7.4",
    "astro": "^7.3.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "marked": "^14.1.4",
    "multiformats": "14.0.5",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.3",
    "@types/sanitize-html": "2.16.1",
    "pagefind": "1.5.2",
    "tsx": "4.23.13"
  }
}
