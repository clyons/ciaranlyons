---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getProjects } from '../lib/content'

const projects = await getProjects()
---

<BaseLayout title="Projects" description="Selected projects by Ciaran Lyons." pagefindBody pagefind={{ type: 'Project' }}>
  <section class="section">
    <h1 class="page-title">Projects</h1>
    <p class="lede">Work, tools, and small systems worth keeping around.</p>
  </section>
  <section class="section">
    <div class="archive-list">
      {projects.map((project) => (
        <a class="project-row" href={project.url} id={project.slug}>
          <div>
            <h2>{project.title}</h2>
            {
              project.emphasis && project.description.includes(project.emphasis)
                ? <p>{project.description.slice(0, project.description.indexOf(project.emphasis))}<em>{project.emphasis}</em>{project.description.slice(project.description.indexOf(project.emphasis) + project.emphasis.length)}</p>
                : <p>{project.description}</p>
            }
            {project.meta && <p class="meta">{project.meta}</p>}
          </div>
          <span class="arrow" aria-hidden="true">-></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
