---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getProjects } from '../lib/content'

const projects = await getProjects()
---

<BaseLayout title="Projects" description="Selected projects by Ciaran Lyons.">
  <section class="section">
    <h1 class="page-title">Things worth keeping around.</h1>
    <p class="lede">Work, tools, and small systems.</p>
  </section>
  <section class="section">
    <div class="archive-list">
      {projects.map((project) => (
        <a class="project-row" href={project.url} id={project.slug}>
          <div>
            <h2>{project.title}</h2>
            <p>{project.description}</p>
            {project.meta && <p class="meta">{project.meta}</p>}
          </div>
          <span class="arrow" aria-hidden="true">-></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
