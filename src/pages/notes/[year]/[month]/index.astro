---
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import { getNotes } from '../../../../lib/atproto'
import { formatDate } from '../../../../lib/dates'

export async function getStaticPaths() {
  const notes = await getNotes(50)
  const months = [...new Set(notes.map((note) => `${note.year}-${note.month}`))]
  return months.map((key) => {
    const [year, month] = key.split('-')
    return { params: { year, month }, props: { year, month, notes: notes.filter((note) => note.year === year && note.month === month) } }
  })
}

const { year, month, notes } = Astro.props
const label = formatDate(`${year}-${month}-01`, { month: 'long', year: 'numeric' })
---

<BaseLayout title={`Notes: ${label}`} description={`Notes from ${label}.`}>
  <section class="section">
    <p class="section-kicker">Notes</p>
    <h1 class="page-title">{label}</h1>
  </section>
  <section class="section">
    <div class="archive-list">
      {notes.map((note) => (
        <a class="note-row" href={note.url}>
          <p>{note.text}</p>
          <span class="date">{formatDate(note.date, { month: 'long', day: 'numeric' })}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
