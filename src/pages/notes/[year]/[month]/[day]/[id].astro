---
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import ArchiveBreadcrumb from '../../../../../components/ArchiveBreadcrumb.astro'
import { getAllNotes, originalPostUrl } from '../../../../../lib/atproto'
import { foundQuoteDescription, foundQuoteTitle, getFoundQuotes, getProjects, getTilEntries, getWriting, noteTitle } from '../../../../../lib/content'
import { formatDate } from '../../../../../lib/dates'
import { canonicalInternalUrl, isDefined } from '../../../../../lib/internal-links'
import { renderRichText } from '../../../../../lib/rich-text'

export async function getStaticPaths() {
  const [notes, tilEntries, writing, foundQuotes, projects] = await Promise.all([
    getAllNotes(),
    getTilEntries(),
    getWriting(),
    getFoundQuotes(),
    getProjects(),
  ])
  const contentReferences = [
    ...tilEntries.map((entry) => ({ ...entry, type: 'TIL' })),
    ...writing.map((entry) => ({ ...entry, type: 'Writing' })),
    ...foundQuotes.map((entry) => ({
      title: foundQuoteTitle(entry),
      description: foundQuoteDescription(entry),
      type: 'Found quote',
      url: entry.url,
    })),
    ...projects.map((entry) => ({ ...entry, type: 'Project' })),
    ...notes.map((entry) => ({
      title: noteTitle(entry),
      description: entry.text.replace(/\s+/g, ' ').trim(),
      type: 'Note',
      url: entry.url,
    })),
  ]
  const referenceByUrl = new Map(contentReferences.map((entry) => [canonicalInternalUrl(entry.url), entry]))

  return notes.map((note) => ({
    params: { year: note.year, month: note.month, day: note.day, id: note.id },
    props: {
      note,
      linkedContent: note.facets
        .flatMap((facet) => facet.features ?? [])
        .flatMap((feature) => feature.uri ? [referenceByUrl.get(canonicalInternalUrl(feature.uri))] : [])
        .filter(isDefined)
        .filter((entry, index, entries) => entries.indexOf(entry) === index),
    },
  }))
}

const { note, linkedContent } = Astro.props
const title = noteTitle(note)
const paragraphs = renderRichText(note.text, note.facets)
  .split(/(?:<br \/>){2,}/)
  .map((html) => ({
    html,
    isStandaloneLink: /^<a [^>]+>https?:\/\/[^<]+<\/a>$/.test(html),
  }))
---

<BaseLayout title={title} description={note.text} canonical={note.url} pagefindBody pagefind={{ type: 'Note', year: note.year, date: note.date }}>
  <article class="article-shell note-detail">
    <ArchiveBreadcrumb archive="notes" />
    <header class="article-header">
      <p class="section-kicker">Note</p>
      <h1 class="visually-hidden">{title}</h1>
    </header>
    <div class="note-post">
      <div class="note-rich-text">
        {paragraphs.map((paragraph) => (
          <p class:list={[paragraph.isStandaloneLink && 'note-standalone-link']} set:html={paragraph.html} />
        ))}
      </div>
      {note.media.length > 0 && (
        <div class="note-media">
          {note.media.map((media) => (
            <figure class="note-media-item">
              {media.type === 'video' ? (
                <video
                  controls
                  muted
                  playsinline
                  autoplay
                  loop
                  preload="metadata"
                  aria-label={media.alt || 'Bluesky video'}
                  style={media.width && media.height ? `aspect-ratio: ${media.width} / ${media.height};` : undefined}
                >
                  <source src={media.src} type={media.mimeType || 'video/mp4'} />
                </video>
              ) : (
                <img
                  src={media.src}
                  alt={media.alt || ''}
                  width={media.width}
                  height={media.height}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </figure>
          ))}
        </div>
      )}
      {linkedContent.length > 0 && (
        <div class="note-content-references">
          {linkedContent.map((entry) => (
            <a class="note-content-reference" href={entry.url}>
              <span class="type-label">{entry.type}</span>
              <span class="note-content-reference-copy">
                <strong>{entry.title}</strong>
                <span>{entry.description}</span>
              </span>
              <span class="note-content-reference-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      )}
      <footer class="note-post-footer">
        <time class="date" datetime={note.date}>
          {formatDate(note.date, { month: 'long', day: 'numeric', year: 'numeric' })}
        </time>
        <a class="text-link note-syndication-link" href={originalPostUrl(note)} rel="syndication">
          Also on Bluesky <span aria-hidden="true">↗</span>
        </a>
      </footer>
    </div>
  </article>
</BaseLayout>
