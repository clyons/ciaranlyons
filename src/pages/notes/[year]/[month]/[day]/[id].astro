---
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import { getNotes, originalPostUrl } from '../../../../../lib/atproto'
import { formatDate } from '../../../../../lib/dates'

export async function getStaticPaths() {
  const notes = await getNotes(50)
  return notes.map((note) => ({
    params: { year: note.year, month: note.month, day: note.day, id: note.id },
    props: { note },
  }))
}

const { note } = Astro.props
---

<BaseLayout title="Note" description={note.text} canonical={note.url}>
  <article class="article-shell">
    <header class="article-header">
      <p class="section-kicker">Ciaran Lyons</p>
      <h1 class="article-title">@ciaranlyons.com</h1>
    </header>
    <div class="prose">
      <blockquote>{note.text}</blockquote>
      {note.media.length > 0 && (
        <div class="note-media">
          {note.media.map((media) => (
            <figure class="note-media-item">
              {media.type === 'video' ? (
                <video
                  controls
                  muted
                  playsinline
                  autoplay
                  loop
                  preload="metadata"
                  aria-label={media.alt || 'Bluesky video'}
                  style={media.width && media.height ? `aspect-ratio: ${media.width} / ${media.height};` : undefined}
                >
                  <source src={media.src} type={media.mimeType || 'video/mp4'} />
                </video>
              ) : (
                <img
                  src={media.src}
                  alt={media.alt || ''}
                  width={media.width}
                  height={media.height}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </figure>
          ))}
        </div>
      )}
      <p class="date">{formatDate(note.date, { month: 'long', day: 'numeric', year: 'numeric' })}</p>
      <p><a href={originalPostUrl(note)}>Original ATProto post</a></p>
    </div>
  </article>
</BaseLayout>
