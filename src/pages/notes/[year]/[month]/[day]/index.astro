---
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import { getNotes } from '../../../../../lib/atproto'
import { formatDate } from '../../../../../lib/dates'

export async function getStaticPaths() {
  const notes = await getNotes(50)
  const days = [...new Set(notes.map((note) => `${note.year}-${note.month}-${note.day}`))]
  return days.map((key) => {
    const [year, month, day] = key.split('-')
    return { params: { year, month, day }, props: { year, month, day, notes: notes.filter((note) => note.year === year && note.month === month && note.day === day) } }
  })
}

const { year, month, day, notes } = Astro.props
const label = formatDate(`${year}-${month}-${day}`, { month: 'long', day: 'numeric', year: 'numeric' })
---

<BaseLayout title={`Notes: ${label}`} description={`Notes from ${label}.`}>
  <section class="section">
    <p class="section-kicker">Notes</p>
    <h1 class="page-title">{label}</h1>
  </section>
  <section class="section">
    <div class="archive-list">
      {notes.map((note) => (
        <a class="note-row" href={note.url}>
          <span class="arrow" aria-hidden="true">-></span>
          <p>{note.text}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
