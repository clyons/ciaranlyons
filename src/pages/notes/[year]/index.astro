---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getNotes } from '../../../lib/atproto'
import { formatDate } from '../../../lib/dates'

export async function getStaticPaths() {
  const notes = await getNotes(50)
  const years = [...new Set(notes.map((note) => note.year))]
  return years.map((year) => ({ params: { year }, props: { year, notes: notes.filter((note) => note.year === year) } }))
}

const { year, notes } = Astro.props
---

<BaseLayout title={`Notes: ${year}`} description={`Notes from ${year}.`}>
  <section class="section">
    <p class="section-kicker">Notes</p>
    <h1 class="page-title">{year}</h1>
  </section>
  <section class="section">
    <div class="archive-list">
      {notes.map((note) => (
        <a class="note-row" href={note.url}>
          <p>{note.text}</p>
          <span class="date">{formatDate(note.date, { month: 'long', day: 'numeric' })}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
