---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getNotes } from '../../lib/atproto'
import { formatDate } from '../../lib/dates'

const notes = await getNotes(50)
---

<BaseLayout title="Notes" description="Short notes from Ciaran Lyons, represented on ciaranlyons.com.">
  <section class="section">
    <p class="section-kicker">Notes</p>
    <h1 class="page-title">Notes</h1>
  </section>
  <section class="section">
    <div class="archive-list">
      {notes.map((note) => (
        <a class="note-row" href={note.url}>
          <span class="date">{formatDate(note.date, { month: 'short', day: '2-digit', year: 'numeric' })}</span>
          <p>{note.text}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
