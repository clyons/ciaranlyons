---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getNotes } from '../../lib/atproto'
import { formatDate } from '../../lib/dates'
import { renderRichText } from '../../lib/rich-text'

const notes = await getNotes(50)
---

<BaseLayout title="Notes" description="Short notes from Ciaran Lyons.">
  <section class="section">
    <p class="section-kicker">Notes</p>
    <h1 class="page-title">Notes</h1>
    <p class="lede">Short notes and observations.</p>
  </section>
  <section class="section">
    <div class="archive-list">
      {notes.map((note) => (
        <article class="note-row">
          <p set:html={renderRichText(note.text, note.facets)} />
          <a class="date" href={note.url} aria-label={`Read note from ${formatDate(note.date, { month: 'long', day: 'numeric' })}`}>
            {formatDate(note.date, { month: 'long', day: 'numeric' })}
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
