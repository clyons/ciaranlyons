---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getAllNotes } from '../../lib/atproto'
import NoteRow from '../../components/NoteRow.astro'

const notes = await getAllNotes()
---

<BaseLayout title="Notes" description="Short notes from Ciaran Lyons.">
  <section class="section">
    <h1 class="page-title">Notes</h1>
    <p class="lede">Short notes and observations.</p>
  </section>
  <section class="section">
    <div class="archive-list">
      {notes.map((note) => <NoteRow note={note} />)}
    </div>
  </section>
</BaseLayout>
