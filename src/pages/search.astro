---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Search" description="Search writing, notes, projects, and TIL entries.">
  <section class="section">
    <p class="section-kicker">Search</p>
    <h1 class="page-title">Search</h1>
    <p class="lede">Find writing, notes, TILs, and projects.</p>
  </section>
  <section class="section">
    <form class="search-form" action="/search/" method="get" role="search">
      <label class="visually-hidden" for="site-search">Search the site</label>
      <input class="search-input" id="site-search" name="q" type="search" placeholder="Search the site" autocomplete="off" />
      <button class="search-button" type="submit">Search</button>
    </form>
    <noscript><p class="search-status">Search needs JavaScript. Browse Writing, Notes, Projects, TILs, or the RSS feed instead.</p></noscript>
    <h2 class="visually-hidden" id="search-results-heading">Search results</h2>
    <p class="search-status" id="search-status" role="status">Loading search index…</p>
    <button class="search-retry" id="search-retry" type="button" hidden>Retry loading search</button>
    <div class="archive-list" id="search-results" aria-labelledby="search-results-heading" aria-busy="true"></div>
  </section>
  <script>
    interface SearchItem {
      type: string
      title: string
      description: string
      content?: string
      url: string
    }

    const input = document.querySelector<HTMLInputElement>('#site-search')
    const results = document.querySelector<HTMLElement>('#search-results')
    const status = document.querySelector<HTMLElement>('#search-status')
    const retry = document.querySelector<HTMLButtonElement>('#search-retry')
    const form = document.querySelector<HTMLFormElement>('.search-form')
    let items: SearchItem[] = []

    const initialQuery = new URLSearchParams(window.location.search).get('q') ?? ''
    if (input) input.value = initialQuery

    function setStatus(message: string) {
      if (status) status.textContent = message
    }

    function render(query: string) {
      if (!results) return
      const q = query.toLowerCase().trim()
      const matches = q
        ? items.filter((item: SearchItem) => `${item.type} ${item.title} ${item.description} ${item.content ?? ''}`.toLowerCase().includes(q))
        : items.slice(0, 12)

      setStatus(q
        ? `${matches.length} ${matches.length === 1 ? 'result' : 'results'} for “${query.trim()}”.`
        : `Showing ${matches.length} recent ${matches.length === 1 ? 'item' : 'items'}.`)

      results.replaceChildren(...matches.map((item: SearchItem) => {
        const link = document.createElement('a')
        link.className = 'search-result'
        link.href = item.url

        const body = document.createElement('div')
        const type = document.createElement('p')
        type.className = 'type-label'
        type.textContent = item.type
        const title = document.createElement('h3')
        title.textContent = item.title
        const description = document.createElement('p')
        description.textContent = item.description
        body.append(type, title, description)

        const arrow = document.createElement('span')
        arrow.className = 'arrow'
        arrow.setAttribute('aria-hidden', 'true')
        arrow.textContent = '->'

        link.append(body, arrow)
        return link
      }))
    }

    async function loadIndex() {
      if (results) results.setAttribute('aria-busy', 'true')
      if (retry) retry.hidden = true
      setStatus('Loading search index…')
      try {
        const response = await fetch('/search.json')
        if (!response.ok) throw new Error(`Search index returned ${response.status}`)
        const payload = await response.json()
        if (!Array.isArray(payload)) throw new Error('Search index has an unexpected format')
        items = payload as SearchItem[]
        render(input?.value ?? '')
      } catch {
        results?.replaceChildren()
        setStatus('Search is temporarily unavailable. You can retry or browse the site sections above.')
        if (retry) retry.hidden = false
      } finally {
        if (results) results.setAttribute('aria-busy', 'false')
      }
    }

    input?.addEventListener('input', () => {
      if (items.length > 0) render(input.value)
    })
    form?.addEventListener('submit', (event) => {
      event.preventDefault()
      const query = input?.value ?? ''
      const url = new URL(window.location.href)
      if (query.trim()) url.searchParams.set('q', query.trim())
      else url.searchParams.delete('q')
      window.history.replaceState({}, '', url)
      if (items.length > 0) render(query)
    })
    retry?.addEventListener('click', loadIndex)
    void loadIndex()
  </script>
</BaseLayout>
