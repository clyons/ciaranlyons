---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Search" description="Search writing, notes, links, projects, TIL entries, and Found Quotes.">
  <section class="section">
    <h1 class="page-title">Search</h1>
  </section>
  <section class="section">
    <form class="search-form" action="/search/" method="get" role="search">
      <label class="visually-hidden" for="site-search">Search the site</label>
      <input class="search-input" id="site-search" name="q" type="search" placeholder="Search the site" autocomplete="off" />
      <input id="search-type" name="type" type="hidden" disabled />
      <button class="search-button" type="submit">Search</button>
    </form>
    <noscript><p class="search-status">Search needs JavaScript. Browse Writing, Notes, Links, Projects, TILs, Found Quotes, or the RSS feed instead.</p></noscript>
    <h2 class="visually-hidden" id="search-results-heading">Search results</h2>
    <p class="search-status" id="search-status" role="status" aria-live="polite">Loading search…</p>
    <button class="search-retry" id="search-retry" type="button" hidden>Retry loading search</button>
    <div class="archive-list" id="search-results" aria-labelledby="search-results-heading" aria-busy="true"></div>
    <nav class="search-pagination" id="search-pagination" aria-label="Search result pages" hidden>
      <button id="search-previous" type="button">← Previous</button>
      <span class="meta" id="search-page"></span>
      <button id="search-next" type="button">Next →</button>
    </nav>
  </section>
  <script>
    interface PagefindResultData {
      url: string
      plain_excerpt: string
      meta: Record<string, string | undefined>
    }

    interface PagefindHandle {
      data: () => Promise<PagefindResultData>
    }

    interface PagefindResponse {
      results: PagefindHandle[]
    }

    interface PagefindApi {
      init: () => Promise<void>
      search: (query: string | null, options?: { filters?: Record<string, string> }) => Promise<PagefindResponse>
      debouncedSearch: (query: string | null, options?: { filters?: Record<string, string> }, debounceMs?: number) => Promise<PagefindResponse | null>
    }

    const resultsPerPage = 12
    const input = document.querySelector<HTMLInputElement>('#site-search')
    const typeInput = document.querySelector<HTMLInputElement>('#search-type')
    const results = document.querySelector<HTMLElement>('#search-results')
    const status = document.querySelector<HTMLElement>('#search-status')
    const retry = document.querySelector<HTMLButtonElement>('#search-retry')
    const form = document.querySelector<HTMLFormElement>('.search-form')
    const pagination = document.querySelector<HTMLElement>('#search-pagination')
    const previous = document.querySelector<HTMLButtonElement>('#search-previous')
    const next = document.querySelector<HTMLButtonElement>('#search-next')
    const pageLabel = document.querySelector<HTMLElement>('#search-page')
    const parameters = new URLSearchParams(window.location.search)
    const initialQuery = parameters.get('q') ?? ''
    const typeFilter = parameters.get('type') ?? ''
    let pagefind: PagefindApi | undefined
    let handles: PagefindHandle[] = []
    let currentPage = 1
    let currentQuery = initialQuery

    if (input) input.value = initialQuery
    if (typeInput && typeFilter) {
      typeInput.value = typeFilter
      typeInput.disabled = false
    }

    function setStatus(message: string) {
      if (status) status.textContent = message
    }

    function searchOptions() {
      return typeFilter ? { filters: { type: typeFilter } } : undefined
    }

    function updateUrl(query: string) {
      const url = new URL(window.location.href)
      if (query.trim()) url.searchParams.set('q', query.trim())
      else url.searchParams.delete('q')
      if (typeFilter) url.searchParams.set('type', typeFilter)
      window.history.replaceState({}, '', url)
    }

    async function renderPage(page: number) {
      if (!results) return
      const totalPages = Math.max(1, Math.ceil(handles.length / resultsPerPage))
      currentPage = Math.min(Math.max(page, 1), totalPages)
      const start = (currentPage - 1) * resultsPerPage
      results.setAttribute('aria-busy', 'true')
      const items = await Promise.all(handles.slice(start, start + resultsPerPage).map((result) => result.data()))

      results.replaceChildren(...items.map((item) => {
        const link = document.createElement('a')
        link.className = 'search-result'
        link.href = item.url

        const body = document.createElement('div')
        const type = document.createElement('p')
        type.className = 'type-label'
        type.textContent = item.meta.type || 'Site'
        const title = document.createElement('h3')
        title.textContent = item.meta.title || item.url
        const description = document.createElement('p')
        description.textContent = item.meta.description || item.plain_excerpt
        body.append(type, title, description)

        const arrow = document.createElement('span')
        arrow.className = 'row-action'
        arrow.setAttribute('aria-hidden', 'true')
        arrow.textContent = '→'
        link.append(body, arrow)
        return link
      }))

      const scope = typeFilter ? `${typeFilter} ` : ''
      setStatus(currentQuery.trim()
        ? `${handles.length} ${scope}${handles.length === 1 ? 'result' : 'results'} for “${currentQuery.trim()}”.`
        : `Showing ${items.length} of ${handles.length} indexed ${scope}${handles.length === 1 ? 'item' : 'items'}.`)
      if (pagination && pageLabel && previous && next) {
        pagination.hidden = handles.length <= resultsPerPage
        pageLabel.textContent = `Page ${currentPage} of ${totalPages}`
        previous.disabled = currentPage === 1
        next.disabled = currentPage === totalPages
      }
      results.setAttribute('aria-busy', 'false')
    }

    async function runSearch(query: string, debounced = false) {
      if (!pagefind) return
      currentQuery = query
      setStatus('Searching…')
      const response = debounced
        ? await pagefind.debouncedSearch(query.trim() || null, searchOptions(), 220)
        : await pagefind.search(query.trim() || null, searchOptions())
      if (!response) return
      handles = response.results
      await renderPage(1)
    }

    async function loadIndex() {
      if (results) results.setAttribute('aria-busy', 'true')
      if (retry) retry.hidden = true
      setStatus('Loading search…')
      try {
        const pagefindPath = '/pagefind/pagefind.js'
        pagefind = await import(/* @vite-ignore */ pagefindPath) as PagefindApi
        await pagefind.init()
        await runSearch(input?.value ?? '')
      } catch {
        results?.replaceChildren()
        setStatus('Search is temporarily unavailable. You can retry or browse the site sections above.')
        if (retry) retry.hidden = false
        if (results) results.setAttribute('aria-busy', 'false')
      }
    }

    input?.addEventListener('input', () => {
      updateUrl(input.value)
      void runSearch(input.value, true)
    })
    input?.addEventListener('focus', () => { void pagefind?.init() })
    form?.addEventListener('submit', (event) => {
      event.preventDefault()
      const query = input?.value ?? ''
      updateUrl(query)
      void runSearch(query)
    })
    previous?.addEventListener('click', () => { void renderPage(currentPage - 1) })
    next?.addEventListener('click', () => { void renderPage(currentPage + 1) })
    retry?.addEventListener('click', loadIndex)
    window.addEventListener('popstate', () => {
      const query = new URLSearchParams(window.location.search).get('q') ?? ''
      if (input) input.value = query
      void runSearch(query)
    })
    void loadIndex()
  </script>
</BaseLayout>
