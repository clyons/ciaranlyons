---
import FoundQuote from '../../components/FoundQuote.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getFoundQuotes } from '../../lib/content'

const quotes = (await getFoundQuotes()).slice(0, 4)
const longQuoteSlug = 'great-silence-and-technological-efficiency'
---

<BaseLayout
  title="Found Quotes type study"
  description="A four-quote study comparing display and reading scales."
  feedUrl="/found-quotes/feed.xml"
  feedTitle="Ciaran Lyons - Found Quotes"
>
  <section class="section">
    <p class="preview-label">Type study · first four quotes</p>
    <h1 class="page-title">Found Quotes</h1>
    <p class="lede">Things other people said that I want to remember.</p>
  </section>
  <section class="section found-quotes-section">
    <div class="found-quotes-list">
      {quotes.map((quote) => (
        <FoundQuote quote={quote} scale={quote.slug === longQuoteSlug ? 'reading' : 'display'} />
      ))}
    </div>
  </section>
</BaseLayout>
