---
import FoundQuote from '../../components/FoundQuote.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getFoundQuotes } from '../../lib/content'
import { foundQuoteTypographyTier, type FoundQuoteTypographyTier } from '../../lib/found-quotes'

const allQuotes = await getFoundQuotes()
const characterCount = (text: string) => Array.from(text.replace(/\s+/gu, ' ').trim()).length
const tierDefinitions: Array<{ tier: FoundQuoteTypographyTier; label: string; summary: string }> = [
  { tier: 'compact', label: 'Compact · Up to 40 characters', summary: 'Large everywhere' },
  { tier: 'responsive', label: 'Responsive · 41–100 characters', summary: 'Large on desktop; smaller on mobile' },
  { tier: 'reading', label: 'Reading · Over 100 characters or multiple paragraphs', summary: 'Smaller everywhere' },
]
const examples = tierDefinitions.map((definition) => {
  const candidates = allQuotes
    .filter((quote) => foundQuoteTypographyTier(quote.text) === definition.tier)
    .sort((a, b) => characterCount(a.text) - characterCount(b.text))
  const quote = definition.tier === 'compact'
    ? candidates[0]
    : candidates.at(-1)
  if (!quote) throw new Error(`Missing Found Quote type-study example for ${definition.tier}`)
  return { ...definition, quote, characterCount: characterCount(quote.text) }
})
---

<BaseLayout
  title="Found Quotes type study"
  description="A three-quote study comparing compact, responsive, and reading scales."
  feedUrl="/found-quotes/feed.xml"
  feedTitle="Ciaran Lyons - Found Quotes"
>
  <section class="section">
    <p class="preview-label">Typography mockup · three lengths</p>
    <h1 class="page-title">Found Quotes</h1>
    <p class="lede">Short quotations stay large. Longer passages settle into a reading scale.</p>
  </section>
  <section class="section found-quotes-section">
    <dl class="type-study-key" aria-label="Proposed Found Quote typography tiers">
      {tierDefinitions.map(({ tier, summary }) => (
        <div>
          <dt>{tier}</dt>
          <dd>{summary}</dd>
        </div>
      ))}
    </dl>
    <div class="found-quotes-list type-study-examples">
      {examples.map((example) => (
        <section class:list={['type-study-example', `type-study-example--${example.tier}`]} aria-labelledby={`type-study-${example.tier}`}>
          <p class="type-study-label" id={`type-study-${example.tier}`}>{example.label} · {example.characterCount} in this example</p>
          <FoundQuote quote={example.quote} />
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .type-study-key {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 0 0 clamp(48px, 7vw, 76px);
    padding: 1px;
    background: var(--hairline);
  }

  .type-study-key div {
    padding: 18px 20px;
    background: var(--bg);
  }

  .type-study-key dt,
  .type-study-label {
    color: var(--ink);
    font-family: var(--mono);
    font-size: .7rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: .085em;
    text-transform: uppercase;
  }

  .type-study-key dd {
    margin: 6px 0 0;
    color: var(--muted);
    font-family: var(--serif);
    line-height: 1.35;
  }

  .type-study-label {
    margin: 0 0 14px;
  }

  .type-study-example :global(.found-quote) {
    border-top: 1px solid var(--hairline);
  }

  @media (max-width: 760px) {
    .type-study-key {
      grid-template-columns: 1fr;
      margin-bottom: 44px;
    }
  }
</style>
