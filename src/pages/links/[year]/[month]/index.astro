---
import LinksArchivePage from '../../../../components/LinksArchivePage.astro'
import { getLinks } from '../../../../lib/content'
import { formatDate } from '../../../../lib/dates'
import { paginateLinks } from '../../../../lib/link-pagination'

export async function getStaticPaths() {
  const links = await getLinks()
  const keys = [...new Set(links.map((entry) => `${entry.year}/${entry.month}`))]
  return keys.map((key) => {
    const [year, month] = key.split('/')
    return { params: { year, month }, props: { year, month, links: links.filter((entry) => entry.year === year && entry.month === month) } }
  })
}

const { year, month, links: allLinks } = Astro.props
const label = formatDate(`${year}-${month}-01`, { month: 'long', year: 'numeric' })
const pagination = paginateLinks(allLinks, 1)
---

<LinksArchivePage
  links={pagination.items}
  totalItems={pagination.totalItems}
  page={pagination.page}
  totalPages={pagination.totalPages}
  basePath={`/links/${year}/${month}/`}
  title={`Links: ${label}`}
  description={`Links saved in ${label}.`}
  kickerHref={`/links/${year}/`}
  kickerLabel={`Links · ${year}`}
  heading={label}
/>
