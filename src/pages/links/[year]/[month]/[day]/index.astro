---
import LinkList from '../../../../../components/LinkList.astro'
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import { getLinks } from '../../../../../lib/content'
import { formatDate } from '../../../../../lib/dates'

export async function getStaticPaths() {
  const links = await getLinks()
  const keys = [...new Set(links.map((entry) => `${entry.year}/${entry.month}/${entry.day}`))]
  return keys.map((key) => {
    const [year, month, day] = key.split('/')
    return { params: { year, month, day }, props: { year, month, day, links: links.filter((entry) => entry.year === year && entry.month === month && entry.day === day) } }
  })
}

const { year, month, day, links } = Astro.props
const label = formatDate(`${year}-${month}-${day}`, { month: 'long', day: 'numeric', year: 'numeric' })
---

<BaseLayout title={`Links: ${label}`} description={`Links saved on ${label}.`} sectionFeed={{ href: '/links/feed.xml', title: 'Ciaran Lyons — Links' }}>
  <section class="section">
    <p class="section-kicker"><a href={`/links/${year}/${month}/`}>Links · {year}/{month}</a></p>
    <h1 class="page-title">{label}</h1>
  </section>
  <section class="section links-archive"><LinkList links={links} /></section>
</BaseLayout>
