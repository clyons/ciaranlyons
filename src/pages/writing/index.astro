---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getWriting } from '../../lib/content'
import { formatDate } from '../../lib/dates'

const writing = await getWriting()
---

<BaseLayout title="Writing" description="Essays by Ciaran Lyons.">
  <section class="section">
    <h1 class="page-title">Writing</h1>
    <p class="lede">Longer pieces on work, systems, and ownership.</p>
  </section>
  <section class="section">
    <div class="archive-list">
      {writing.map((item) => (
        <a class="row-link" href={item.url}>
          <div>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
          </div>
          <time class="date" datetime={item.date}>{formatDate(item.date, { month: 'long', year: 'numeric' })}</time>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
