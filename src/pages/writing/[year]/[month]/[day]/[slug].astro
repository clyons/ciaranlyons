---
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import { getWriting } from '../../../../../lib/content'

export async function getStaticPaths() {
  const writing = await getWriting()
  return writing.map((entry) => ({
    params: { year: entry.year, month: entry.month, day: entry.day, slug: entry.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
---

<BaseLayout
  title={entry.title}
  description={entry.description}
  canonical={entry.url}
  standardDocumentUri={entry.standardUri}
>
  <article class="article-shell">
    <header class="article-header">
      <p class="date">{new Date(entry.date).toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
      <h1 class="article-title">{entry.title}</h1>
      <p class="lede">{entry.description}</p>
    </header>
    <div class="prose" set:html={entry.html} />
  </article>
</BaseLayout>
