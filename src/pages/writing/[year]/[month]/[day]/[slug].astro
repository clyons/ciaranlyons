---
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import FoundQuote from '../../../../../components/FoundQuote.astro'
import { getFoundQuotes, getWriting, resolveFoundQuotes } from '../../../../../lib/content'
import { formatDate } from '../../../../../lib/dates'

export async function getStaticPaths() {
  const [writing, foundQuotes] = await Promise.all([getWriting(), getFoundQuotes()])
  return writing.map((entry) => ({
    params: { year: entry.year, month: entry.month, day: entry.day, slug: entry.slug },
    props: { entry, embeddedQuotes: resolveFoundQuotes(entry.foundQuoteSlugs, foundQuotes, `content/writing/${entry.slug}.md`) },
  }))
}

const { entry, embeddedQuotes } = Astro.props
---

<BaseLayout
  title={entry.title}
  description={entry.description}
  canonical={entry.url}
  standardDocumentUri={entry.standardUri}
>
  <article class="article-shell">
    <header class="article-header">
      <p><time class="date" datetime={entry.date}>{formatDate(entry.date, { month: 'long', day: 'numeric', year: 'numeric' })}</time></p>
      <h1 class="article-title">{entry.title}</h1>
      <p class="lede">{entry.description}</p>
    </header>
    <div class="prose" set:html={entry.html} />
    {embeddedQuotes.length > 0 && (
      <section class="writing-found-quotes" aria-labelledby="writing-found-quotes-title">
        <h2 id="writing-found-quotes-title">Found quotes</h2>
        <div class="found-quotes-list">
          {embeddedQuotes.map((quote) => <FoundQuote quote={quote} context="writing" />)}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
