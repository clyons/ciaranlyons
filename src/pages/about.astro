---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getAbout } from '../lib/content'
import { socialLinks } from '../lib/socials'

const about = await getAbout()
---

<BaseLayout title="About" description="About Ciaran Lyons.">
  <article class="article-shell">
    <header class="article-header">
      <h1 class="article-title">About Ciaran</h1>
    </header>
    <picture>
      <source
        type="image/avif"
        srcset="/images/profile/ciaran-profile-256.avif 256w, /images/profile/ciaran-profile-416.avif 416w"
        sizes="(max-width: 760px) 144px, 208px"
      />
      <img
        class="about-portrait"
        src="/images/ciaran-profile.jpeg?v=20260906"
        alt="Ciaran Lyons"
        width="1200"
        height="1200"
        decoding="async"
      />
    </picture>
    <div class="prose" set:html={about.html} />
    <section class="about-socials" aria-labelledby="about-socials-heading">
      <h2 id="about-socials-heading">Elsewhere</h2>
      <nav class="social-links" aria-label="Social profiles">
        {
          socialLinks.map((link) => (
            <a href={link.href} rel="me">
              {link.label}
            </a>
          ))
        }
      </nav>
    </section>
  </article>
</BaseLayout>
