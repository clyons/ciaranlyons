---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getNotes } from '../lib/atproto'
import { getProjects, getWriting } from '../lib/content'
import { formatDate } from '../lib/dates'
import { renderRichText } from '../lib/rich-text'

const [writing, notes, projects] = await Promise.all([getWriting(), getNotes(1), getProjects()])
const featuredWriting = writing[0]
const latestNote = notes[0]
const selectedProjects = projects.slice(0, 2)
const featuredExcerpt = featuredWriting?.body.split(/\n\s*\n/)[1]?.split(/(?<=\.)\s+/)[0] ?? featuredWriting?.description
---

<BaseLayout description="Ciaran Lyons writes about operations, growth, teams, companies, and mental fitness.">
  <section class="home-intro" aria-labelledby="home-title">
    <div class="home-proposition">
      <h1 id="home-title">I build things that last <em>and</em> grow.</h1>
      <p>In the past, websites and communities; lately, teams and companies. Every day, mental fitness.</p>
    </div>
    {latestNote && (
      <aside class="latest-note" aria-labelledby="latest-note-title">
        <p class="section-kicker" id="latest-note-title">Latest note</p>
        <p class="date">{formatDate(latestNote.date, { month: 'long', day: 'numeric', year: 'numeric' })}</p>
        <div class="latest-note-copy" set:html={renderRichText(latestNote.text, latestNote.facets)} />
        <a class="text-link" href={latestNote.url}>Read note</a>
      </aside>
    )}
  </section>

  {featuredWriting && (
    <section class="featured-essay" aria-labelledby="featured-essay-title">
      <div class="featured-essay-heading">
        <p class="section-kicker">Latest essay</p>
        <p class="date">{formatDate(featuredWriting.date, { month: 'long', day: 'numeric', year: 'numeric' })}</p>
        <h2 id="featured-essay-title">{featuredWriting.title}</h2>
        <p class="featured-dek">{featuredWriting.description}</p>
      </div>
      <div class="featured-essay-summary">
        <p>{featuredExcerpt}</p>
        <a class="text-link" href={featuredWriting.url}>Read the essay</a>
      </div>
    </section>
  )}

  <section class="home-projects" aria-labelledby="projects-title">
    <div class="section-heading">
      <p class="section-kicker" id="projects-title">Selected projects</p>
    </div>
    <div class="archive-list">
      {selectedProjects.map((project) => (
        <a class="project-row" href={project.url}>
          <div>
            <h3>{project.title}</h3>
            {
              project.emphasis && project.description.includes(project.emphasis)
                ? <p>{project.description.slice(0, project.description.indexOf(project.emphasis))}<em>{project.emphasis}</em>{project.description.slice(project.description.indexOf(project.emphasis) + project.emphasis.length)}</p>
                : <p>{project.description}</p>
            }
            {project.meta && <p class="meta">{project.meta}</p>}
          </div>
          <span class="project-action" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
