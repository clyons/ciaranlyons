---
import BaseLayout from '../layouts/BaseLayout.astro'
import FoundQuote from '../components/FoundQuote.astro'
import LatestNote from '../components/LatestNote.astro'
import { getNotes } from '../lib/atproto'
import { getFoundQuotes, getProjects, getWriting } from '../lib/content'
import { formatDate } from '../lib/dates'

const [writing, notes, projects, foundQuotes] = await Promise.all([getWriting(), getNotes(1), getProjects(), getFoundQuotes()])
const featuredWriting = writing.find((entry) => entry.featured) ?? writing[0]
const latestNote = notes[0]
const latestFoundQuote = foundQuotes[0]
const showLatestFoundQuote = latestFoundQuote && !featuredWriting?.foundQuoteSlugs.includes(latestFoundQuote.slug)
const featuredParagraphs = featuredWriting?.body
  .split(/\n\s*\n/)
  .filter((paragraph) => paragraph.trim())
const secondParagraph = featuredParagraphs?.[1]
const featuredExcerpt = (secondParagraph && !/^\s*(?:[-*+]|\d+[.)])\s/u.test(secondParagraph)
  ? secondParagraph
  : featuredParagraphs?.[0])
  ?.split(/(?<=\.)\s+/)[0] ?? featuredWriting?.description
---

<BaseLayout description="Ciaran Lyons writes about operations, growth, teams, companies, and mental fitness.">
  <section class="home-intro" aria-labelledby="home-title">
    <div class="home-proposition">
      <h1 id="home-title">I build things that last <em>and</em> grow.</h1>
      <p>In the past, websites and communities; lately, teams and companies. Every day, mental fitness.</p>
    </div>
    {latestNote && <LatestNote note={latestNote} />}
  </section>

  {featuredWriting && (
    <section class="featured-essay" aria-labelledby="featured-essay-title">
      <div class="featured-essay-heading">
        <p class="section-kicker">Featured writing</p>
        <time class="date" datetime={featuredWriting.date}>{formatDate(featuredWriting.date, { month: 'long', day: 'numeric', year: 'numeric' })}</time>
        <h2 id="featured-essay-title">{featuredWriting.title}</h2>
        <p class="featured-dek">{featuredWriting.description}</p>
      </div>
      <div class="featured-essay-summary">
        <p>{featuredExcerpt}</p>
        <a class="text-link" href={featuredWriting.url}>Read the essay</a>
      </div>
    </section>
  )}

  {showLatestFoundQuote && (
    <section class="home-found-quotes" aria-labelledby="latest-found-quote-title">
      <div class="section-heading">
        <p class="section-kicker" id="latest-found-quote-title">Latest found quote</p>
      </div>
      <FoundQuote quote={latestFoundQuote} context="home" />
    </section>
  )}

  <section class="home-projects" aria-labelledby="projects-title">
    <div class="section-heading">
      <p class="section-kicker" id="projects-title">Projects</p>
    </div>
    <div class="archive-list">
      {projects.map((project) => (
        <a class="project-row" href={project.url}>
          <div>
            <h3>{project.title}</h3>
            {
              project.emphasis && project.description.includes(project.emphasis)
                ? <p>{project.description.slice(0, project.description.indexOf(project.emphasis))}<em>{project.emphasis}</em>{project.description.slice(project.description.indexOf(project.emphasis) + project.emphasis.length)}</p>
                : <p>{project.description}</p>
            }
            {project.meta && <p class="meta">{project.meta}</p>}
          </div>
          <span class="row-action" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
