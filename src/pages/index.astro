---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getNotes } from '../lib/atproto'
import { getProjects, getWriting } from '../lib/content'
import { formatDate } from '../lib/dates'

const [writing, notes, projects] = await Promise.all([getWriting(), getNotes(5), getProjects()])
const selectedWriting = writing.slice(0, 2)
const selectedProjects = projects.slice(0, 3)
---

<BaseLayout description="Ciaran Lyons writes about operations, systems, automation, and the owned web.">
  <section class="hero" aria-labelledby="home-title">
    <h1 id="home-title">Ciaran Lyons</h1>
    <div class="hero-copy">
      <p class="dek">Systems, teams, and useful experiments.</p>
      <p class="lede">COO at Positive Intelligence. Previously growth, SEO, automation, and community.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="writing-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Writing</p>
        <h2 id="writing-title">Longer pieces on work, systems, and ownership.</h2>
      </div>
      <a href="/writing">All writing</a>
    </div>
    <div class="archive-list">
      {selectedWriting.map((item) => (
        <a class="row-link" href={item.url}>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
          <span class="date">{formatDate(item.date, { month: 'long', year: 'numeric' })}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="notes-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Notes</p>
        <h2 id="notes-title">Short posts, saved here too.</h2>
      </div>
      <a href="/notes">All notes</a>
    </div>
    <div class="archive-list">
      {notes.slice(0, 4).map((note) => (
        <a class="note-row" href={note.url}>
          <span class="date">{formatDate(note.date, { month: 'short', day: '2-digit' })}</span>
          <p>{note.text}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="projects-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Projects</p>
        <h2 id="projects-title">Selected work and useful experiments.</h2>
      </div>
      <a href="/projects">All projects</a>
    </div>
    <div class="archive-list">
      {selectedProjects.map((project) => (
        <a class="project-row" href={project.url}>
          <div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
          </div>
          <span class="arrow" aria-hidden="true">-></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
