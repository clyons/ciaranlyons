---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getTilEntries } from '../../../lib/content'
import { formatDate } from '../../../lib/dates'

export async function getStaticPaths() {
  const entries = await getTilEntries()
  const topics = [...new Set(entries.map((entry) => entry.topic))]
  return topics.map((topic) => ({
    params: { topic },
    props: { topic, entries: entries.filter((entry) => entry.topic === topic) },
  }))
}

const { topic, entries } = Astro.props
---

<BaseLayout title={`TIL: ${topic}`} description={`TIL entries about ${topic}.`}>
  <section class="section">
    <p class="section-kicker">Topic</p>
    <h1 class="page-title">{topic}</h1>
  </section>
  <section class="section">
    <div class="archive-list">
      {entries.map((entry) => (
        <a class="row-link" href={entry.url}>
          <div>
            <h2>{entry.title}</h2>
            <p>{entry.description}</p>
          </div>
          <time class="date" datetime={entry.date}>{formatDate(entry.date, { month: 'short', day: 'numeric', year: 'numeric' })}</time>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
