---
import { getTilEntries } from '../../../../../../lib/content'

export async function getStaticPaths() {
  const entries = await getTilEntries()
  return entries.map((entry) => ({
    params: { topic: entry.topic, year: entry.year, month: entry.month, day: entry.day, slug: entry.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
const target = entry.url
const canonicalTarget = new URL(target, Astro.site ?? new URL('https://ciaranlyons.com'))
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonicalTarget} />
    <title>Redirecting to {entry.title}</title>
  </head>
  <body>
    <a href={target}>Redirecting to {entry.title}</a>
  </body>
</html>
