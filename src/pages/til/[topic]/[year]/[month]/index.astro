---
import { getTilEntries } from '../../../../../lib/content'

export async function getStaticPaths() {
  const entries = await getTilEntries()
  const keys = [...new Set(entries.map((entry) => `${entry.topic}/${entry.year}/${entry.month}`))]
  return keys.map((key) => {
    const [topic, year, month] = key.split('/')
    return { params: { topic, year, month }, props: { year, month } }
  })
}

const { year, month } = Astro.props
const target = `/til/${year}/${month}/`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Redirecting</title>
  </head>
  <body>
    <a href={target}>Redirecting</a>
  </body>
</html>
