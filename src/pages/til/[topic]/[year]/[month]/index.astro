---
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import { getTilEntries } from '../../../../../lib/content'

export async function getStaticPaths() {
  const entries = await getTilEntries()
  const keys = [...new Set(entries.map((entry) => `${entry.topic}/${entry.year}/${entry.month}`))]
  return keys.map((key) => {
    const [topic, year, month] = key.split('/')
    return { params: { topic, year, month }, props: { topic, year, month, entries: entries.filter((entry) => entry.topic === topic && entry.year === year && entry.month === month) } }
  })
}

const { topic, year, month, entries } = Astro.props
const label = new Date(`${year}-${month}-01T00:00:00Z`).toLocaleDateString('en', { month: 'long', year: 'numeric', timeZone: 'UTC' })
---

<BaseLayout title={`TIL: ${topic} / ${label}`} description={`TIL entries about ${topic} from ${label}.`}>
  <section class="section">
    <p class="section-kicker">TIL Topic</p>
    <h1 class="page-title">{topic} / {label}</h1>
  </section>
  <section class="section">
    <div class="archive-list">
      {entries.map((entry) => (
        <a class="row-link" href={entry.url}>
          <div>
            <h2>{entry.title}</h2>
            <p>{entry.description}</p>
          </div>
          <span class="date">{new Date(entry.date).toLocaleDateString('en', { month: 'short', day: 'numeric' })}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
