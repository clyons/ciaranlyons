---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getTilEntries } from '../../../lib/content'
import { formatDate } from '../../../lib/dates'

export async function getStaticPaths() {
  const entries = await getTilEntries()
  const years = [...new Set(entries.map((entry) => entry.year))]
  return years.map((year) => ({
    params: { year },
    props: { year, entries: entries.filter((entry) => entry.year === year) },
  }))
}

const { year, entries } = Astro.props
---

<BaseLayout title={`TIL: ${year}`} description={`TIL entries from ${year}.`}>
  <section class="section">
    <p class="section-kicker">TIL</p>
    <h1 class="page-title">{year}</h1>
  </section>
  <section class="section">
    <div class="archive-list">
      {entries.map((entry) => (
        <a class="row-link" href={entry.url}>
          <div>
            <h2>{entry.title}</h2>
            <p>{entry.topic} - {entry.description}</p>
          </div>
          <time class="date" datetime={entry.date}>{formatDate(entry.date, { month: 'short', day: 'numeric' })}</time>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
