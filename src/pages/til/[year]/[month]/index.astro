---
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import { getTilEntries } from '../../../../lib/content'
import { formatDate } from '../../../../lib/dates'

export async function getStaticPaths() {
  const entries = await getTilEntries()
  const keys = [...new Set(entries.map((entry) => `${entry.year}/${entry.month}`))]
  return keys.map((key) => {
    const [year, month] = key.split('/')
    return { params: { year, month }, props: { year, month, entries: entries.filter((entry) => entry.year === year && entry.month === month) } }
  })
}

const { year, month, entries } = Astro.props
const label = formatDate(`${year}-${month}-01`, { month: 'long', year: 'numeric' })
---

<BaseLayout title={`TIL: ${label}`} description={`TIL entries from ${label}.`}>
  <section class="section">
    <p class="section-kicker">TIL Archive</p>
    <h1 class="page-title">{label}</h1>
  </section>
  <section class="section">
    <div class="archive-list">
      {entries.map((entry) => (
        <a class="row-link" href={entry.url}>
          <div>
            <h2>{entry.title}</h2>
            <p>{entry.topic} - {entry.description}</p>
          </div>
          <span class="date">{formatDate(entry.date, { month: 'short', day: 'numeric' })}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
