---
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import ArchiveBreadcrumb from '../../../../../components/ArchiveBreadcrumb.astro'
import { getTilEntries } from '../../../../../lib/content'
import { formatDate } from '../../../../../lib/dates'

export async function getStaticPaths() {
  const entries = await getTilEntries()
  return entries.map((entry) => ({
    params: { year: entry.year, month: entry.month, day: entry.day, slug: entry.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
---

<BaseLayout title={entry.title} description={entry.description} canonical={entry.url} pagefindBody pagefind={{ type: 'TIL', year: entry.year, tags: entry.tags, date: entry.date }}>
  <article class="article-shell">
    <ArchiveBreadcrumb archive="til" />
    <header class="article-header">
      <p class="date">{entry.topic} - <time datetime={entry.date}>{formatDate(entry.date, { month: 'long', day: 'numeric', year: 'numeric' })}</time></p>
      <h1 class="article-title">{entry.title}</h1>
      <p class="lede">{entry.description}</p>
    </header>
    <div class="prose" set:html={entry.html} />
  </article>
</BaseLayout>
