---
import type { LinkEntry } from '../lib/content'
import BaseLayout from '../layouts/BaseLayout.astro'
import LinkList from './LinkList.astro'
import LinkPagination from './LinkPagination.astro'

interface Props {
  links: LinkEntry[]
  totalItems: number
  page: number
  totalPages: number
  basePath: string
  title: string
  description: string
  kickerHref: string
  kickerLabel: string
  heading: string
}

const { links, totalItems, page, totalPages, basePath, title, description, kickerHref, kickerLabel, heading } = Astro.props
---

<BaseLayout title={page === 1 ? title : `${title} — Page ${page}`} description={description} canonical={page === 1 ? basePath : `${basePath}page/${page}/`} socialImagePath="/links/" sectionFeed={{ href: '/links/feed.xml', title: 'Ciaran Lyons — Links' }}>
  <section class="section">
    <p class="section-kicker"><a href={kickerHref}>{kickerLabel}</a></p>
    <h1 class="page-title">{heading}</h1>
    <p class="lede">{totalItems} saved {totalItems === 1 ? 'link' : 'links'}.</p>
  </section>
  <section class="section links-archive">
    <LinkList links={links} />
    <LinkPagination {basePath} {page} {totalPages} {totalItems} />
  </section>
</BaseLayout>
