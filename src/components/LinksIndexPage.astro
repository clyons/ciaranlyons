---
import type { LinkEntry } from '../lib/content'
import LinkList from './LinkList.astro'
import LinkPagination from './LinkPagination.astro'
import BaseLayout from '../layouts/BaseLayout.astro'

interface Props {
  links: LinkEntry[]
  allLinks: LinkEntry[]
  page: number
  totalPages: number
}

const { links, allLinks, page, totalPages } = Astro.props
const years = [...new Set(allLinks.map((entry) => entry.year))]
const sources = new Set(allLinks.map((entry) => entry.sourceTitle ?? new URL(entry.targetUrl).hostname)).size
const isMockPreview = allLinks.length > 0 && allLinks.every((entry) => entry.mock)
const canonical = page === 1 ? '/links/' : `/links/page/${page}/`
---

<BaseLayout
  title={page === 1 ? 'Links' : `Links — Page ${page}`}
  description="Articles, ideas, and references saved by Ciaran Lyons."
  canonical={canonical}
  socialImagePath="/links/"
  sectionFeed={{ href: '/links/feed.xml', title: 'Ciaran Lyons — Links' }}
>
  <section class="section links-heading">
    <div>
      <p class="section-kicker">Curated, not collected</p>
      <h1 class="page-title">Links</h1>
    </div>
    <div class="links-heading__note">
      {isMockPreview && <p class="preview-data">Preview data · Mock Feedly stars</p>}
      <p>Articles, ideas, and references I want to find again.</p>
      <p class="meta">{allLinks.length} links · {sources} sources</p>
    </div>
  </section>
  <section class="section links-tools">
    <form action="/search/" method="get" role="search">
      <label class="visually-hidden" for="links-search">Search links</label>
      <input class="search-input" id="links-search" name="q" type="search" placeholder="Search titles, sources, authors, and tags" />
      <input name="type" type="hidden" value="Link" />
    </form>
    <nav class="links-years" aria-label="Links by year">
      {years.map((year) => <a href={`/links/${year}/`}>{year}</a>)}
      <a href="/links/feed.xml">RSS</a>
    </nav>
  </section>
  <section class="section links-archive" aria-labelledby="recent-links">
    <div class="section-heading">
      <h2 id="recent-links" class="list-title">Recently saved</h2>
    </div>
    <LinkList links={links} />
    <LinkPagination basePath="/links/" page={page} totalPages={totalPages} totalItems={allLinks.length} />
  </section>
</BaseLayout>
