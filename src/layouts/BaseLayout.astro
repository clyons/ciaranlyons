---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  canonical?: string
  standardDocumentUri?: string
}

const {
  title = 'Ciaran Lyons',
  description = 'Ciaran Lyons writes about operations, systems, automation, and the owned web.',
  canonical = Astro.url.pathname,
  standardDocumentUri,
} = Astro.props

const site = Astro.site ?? new URL('https://ciaranlyons.com')
const canonicalUrl = new URL(canonical, site)
const assetVersion = '20260906'
const profileImageUrl = new URL(`/images/ciaran-profile.jpeg?v=${assetVersion}`, site)
const pageTitle = title === 'Ciaran Lyons' ? title : `${title} - Ciaran Lyons`
const standardPublicationUri = import.meta.env.STANDARD_SITE_PUBLICATION_AT_URI
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const navItems = [
  { href: '/about/', match: '/about', label: 'About' },
  { href: '/writing/', match: '/writing', label: 'Writing' },
  { href: '/notes/', match: '/notes', label: 'Notes' },
  { href: '/projects/', match: '/projects', label: 'Projects' },
]
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ciaran Lyons',
  url: site.toString(),
  image: profileImageUrl.toString(),
  sameAs: ['https://bsky.app/profile/ciaranlyons.com'],
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="48x48" href={`/favicon.png?v=${assetVersion}`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon.png?v=${assetVersion}`} />
    <link rel="alternate" type="application/rss+xml" title="Ciaran Lyons" href="/feed.xml" />
    {standardPublicationUri && <link rel="site.standard.publication" href={standardPublicationUri} />}
    {standardDocumentUri && <link rel="site.standard.document" href={standardDocumentUri} />}
    <script is:inline>
      ;(() => {
        const storageKey = 'ciaranlyons-theme'
        const root = document.documentElement
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'

        try {
          const savedTheme = window.localStorage.getItem(storageKey)
          const resolvedTheme = savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : systemTheme
          root.dataset.theme = resolvedTheme
          root.classList.toggle('dark', resolvedTheme === 'dark')
        } catch {
          root.dataset.theme = systemTheme
          root.classList.toggle('dark', systemTheme === 'dark')
        }
      })()
    </script>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={profileImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content="Portrait of Ciaran Lyons" />
    <meta property="og:site_name" content="Ciaran Lyons" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={profileImageUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/">Ciaran Lyons</a>
        <nav class="nav" aria-label="Primary navigation">
          {navItems.map((item) => (
            <a href={item.href} aria-current={pathname === item.match || pathname.startsWith(`${item.match}/`) ? 'page' : undefined}>{item.label}</a>
          ))}
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color scheme" title="Toggle color scheme">
            <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
            <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.4 15.1A8.5 8.5 0 0 1 8.9 3.6 8.5 8.5 0 1 0 20.4 15.1Z" />
            </svg>
          </button>
        </nav>
      </header>
      <main class="page" id="main-content" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <nav aria-label="Footer navigation">
          <a href="/feed.xml">RSS</a>
          <a href="https://bsky.app/profile/ciaranlyons.com" rel="me">@ciaranlyons.com</a>
        </nav>
        <span>© Ciaran Lyons</span>
      </footer>
    </div>
    <script is:inline>
      ;(() => {
        if (window.__ciaranThemeToggleInitialized) {
          window.__ciaranBindThemeToggles?.()
          return
        }

        window.__ciaranThemeToggleInitialized = true

        const storageKey = 'ciaranlyons-theme'
        const root = document.documentElement
        const media = window.matchMedia('(prefers-color-scheme: dark)')

        const systemTheme = () => (media.matches ? 'dark' : 'light')
        const savedTheme = () => {
          try {
            const value = window.localStorage.getItem(storageKey)
            return value === 'light' || value === 'dark' ? value : null
          } catch {
            return null
          }
        }
        const setTheme = (theme) => {
          root.dataset.theme = theme
          root.classList.toggle('dark', theme === 'dark')
          updateToggles()
        }
        const updateToggles = () => {
          const activeTheme = root.dataset.theme === 'dark' ? 'dark' : 'light'
          const nextTheme = activeTheme === 'dark' ? 'light' : 'dark'
          const isSystemTheme = !savedTheme()
          const action = nextTheme === systemTheme() && !isSystemTheme ? `Return to system ${nextTheme} mode` : `Switch to ${nextTheme} mode`

          document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
            button.setAttribute('aria-label', action)
            button.setAttribute('title', action)
            button.setAttribute('aria-pressed', String(activeTheme === 'dark'))
          })
        }
        const toggleTheme = () => {
          const activeTheme = root.dataset.theme === 'dark' ? 'dark' : 'light'
          const nextTheme = activeTheme === 'dark' ? 'light' : 'dark'

          try {
            if (nextTheme === systemTheme()) {
              window.localStorage.removeItem(storageKey)
            } else {
              window.localStorage.setItem(storageKey, nextTheme)
            }
          } catch {
            // Keep the current-session change when storage is unavailable.
          }

          setTheme(nextTheme)
        }
        const bindThemeToggles = () => {
          document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
            if (button.dataset.themeToggleBound) return
            button.dataset.themeToggleBound = 'true'
            button.addEventListener('click', toggleTheme)
          })

          setTheme(savedTheme() ?? systemTheme())
        }

        media.addEventListener('change', () => {
          if (!savedTheme()) setTheme(systemTheme())
        })

        window.__ciaranBindThemeToggles = bindThemeToggles
        bindThemeToggles()
        document.addEventListener('astro:after-swap', bindThemeToggles)
      })()
    </script>
  </body>
</html>
