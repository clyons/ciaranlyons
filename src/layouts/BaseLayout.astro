---
import '../styles/global.css'
import { socialLinks } from '../lib/socials'

interface Props {
  title?: string
  description?: string
  canonical?: string
  standardDocumentUri?: string
}

const {
  title = 'Ciaran Lyons',
  description = 'Ciaran Lyons writes about operations, systems, automation, and the owned web.',
  canonical = Astro.url.pathname,
  standardDocumentUri,
} = Astro.props

const site = Astro.site ?? new URL('https://ciaranlyons.com')
const canonicalUrl = new URL(canonical, site)
const profileImageUrl = new URL('/images/ciaran-profile.jpeg', site)
const pageTitle = title === 'Ciaran Lyons' ? title : `${title} - Ciaran Lyons`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Ciaran Lyons" href="/feed.xml" />
    {standardDocumentUri && <link rel="site.standard.document" href={standardDocumentUri} />}
    <!-- Google Tag Manager -->
    <script is:inline>
      ;(function (w, d, s, l, i) {
        w[l] = w[l] || []
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
        var f = d.getElementsByTagName(s)[0]
        var j = d.createElement(s)
        var dl = l != 'dataLayer' ? '&l=' + l : ''
        j.async = true
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl
        f.parentNode.insertBefore(j, f)
      })(window, document, 'script', 'dataLayer', 'GTM-TJDNFN6S')
    </script>
    <!-- End Google Tag Manager -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={profileImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content="Portrait of Ciaran Lyons" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/">Ciaran Lyons</a>
        <nav class="nav" aria-label="Primary navigation">
          <a href="/about">About</a>
          <a href="/writing">Writing</a>
          <a href="/notes">Notes</a>
          <a href="/projects">Projects</a>
        </nav>
      </header>
      <main class="page">
        <slot />
      </main>
      <footer class="site-footer">
        <span>ciaranlyons.com</span>
        <nav aria-label="Footer navigation">
          <a href="/feed.xml">RSS</a>
          {
            socialLinks.map((link) => (
              <a href={link.href} rel="me">
                {link.label}
              </a>
            ))
          }
        </nav>
      </footer>
    </div>
  </body>
</html>
